#!/usr/bin/env bash
#
# Seeds an ephemeral promat feature-preview or local disposable database after the app has run Flyway.
#
# Safety: refuses to run unless the host is inside the promat-features namespace or localhost.

set -euo pipefail

HOST=""
PORT="5432"
DBNAME="promat_db"
DBUSER="promat"
DBPASSWORD="promat"
SEED_SQL="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/seed.sql"

usage() {
  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
  echo
  echo "Usage: $0 --host HOST [--port 5432] [--dbname promat_db] [--dbuser promat] [--dbpassword promat] [--seed-sql PATH]"
  echo "For local dev DBs from scripts/start-database, pass: --host 127.0.0.1 --port 5432 --dbname \${USER} --dbuser \${USER} --dbpassword \${USER}"
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host) HOST="$2"; shift 2 ;;
    --port) PORT="$2"; shift 2 ;;
    --dbname) DBNAME="$2"; shift 2 ;;
    --dbuser) DBUSER="$2"; shift 2 ;;
    --dbpassword) DBPASSWORD="$2"; shift 2 ;;
    --seed-sql) SEED_SQL="$2"; shift 2 ;;
    -h|--help) usage ;;
    *) echo "Unknown argument: $1" >&2; usage ;;
  esac
done

: "${HOST:?--host is required}"

HOST="${HOST#http://}"
HOST="${HOST#https://}"
HOST="${HOST%/}"

if [[ "$HOST" != *".promat-features.svc.cloud.dbc.dk" &&
      "$HOST" != *".promat-features.svc.cluster.local" &&
      "$HOST" != "127.0.0.1" &&
      "$HOST" != "localhost" ]]; then
  echo "ERROR: refusing to seed database host '$HOST'." >&2
  echo "Expected a host in the promat-features namespace or localhost." >&2
  exit 1
fi

if [[ ! -f "$SEED_SQL" ]]; then
  echo "ERROR: seed SQL file not found: $SEED_SQL" >&2
  exit 1
fi

export PGPASSWORD="$DBPASSWORD"

echo "Waiting for migrated schema in $HOST:$PORT/$DBNAME ..."
for _ in $(seq 1 120); do
  if psql -h "$HOST" -p "$PORT" -U "$DBUSER" -d "$DBNAME" -tAc "select 1 from schema_version limit 1" >/dev/null 2>&1; then
    echo "Schema is ready. Applying feature-preview seed data ..."
    psql -h "$HOST" -p "$PORT" -U "$DBUSER" -d "$DBNAME" -v ON_ERROR_STOP=1 -f "$SEED_SQL"
    echo "Feature-preview seed data applied."
    exit 0
  fi
  sleep 2
done

echo "ERROR: timed out waiting for schema_version in $HOST:$PORT/$DBNAME" >&2
exit 1
