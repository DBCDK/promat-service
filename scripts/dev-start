#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."
source "$(realpath "$(dirname "${0}")/..")/scripts/common"

# Seed the local database with sample data after migrations (default on).
# Disable with --no-seed or DEV_SEED=false (e.g. in .env.local).
DEV_SEED=${DEV_SEED:-true}
DB_IMAGE="docker.dbc.dk/dbc-postgres-13:latest"
for arg in "$@"; do
    case "$arg" in
        --no-seed) DEV_SEED=false ;;
        *) echo "Unknown argument: $arg"; echo "Usage: $0 [--no-seed]"; exit 1 ;;
    esac
done

echo "Starting Promat Service Development Environment"
echo ""

warnIfTemplateOnly

# Check if Java 21+ is available
JAVA_VERSION=$(java -version 2>&1 | head -n 1 | cut -d'"' -f2 | cut -d'.' -f1)
if [ "$JAVA_VERSION" -lt 21 ]; then
    echo "Java 21+ required, but found Java $JAVA_VERSION"
    echo ""
    echo "Please activate Java 21+:"
    echo "  Option 1 (SDKMAN): sdk env"
    echo "  Option 2 (macOS):  export JAVA_HOME=\$(/usr/libexec/java_home -v 25)"
    echo ""
    exit 1
fi

echo "Java version: $(java -version 2>&1 | head -n 1)"
echo ""

# Check if Docker image exists
if ! docker image inspect docker-metascrum.artifacts.dbccloud.dk/promat-service:devel &> /dev/null; then
    echo "Docker image not found. Building..."
    mvn clean verify -DskipTests
    echo ""
fi

# Stop any existing containers
if docker ps -a -q -f name=^promat-service-database$ | grep -q . || docker ps -a -q -f name=^promat-service-8080$ | grep -q .; then
    echo "Stopping existing containers..."
    docker stop promat-service-database 2>/dev/null || true
    docker stop promat-service-8080 2>/dev/null || true
    sleep 2
    echo ""
fi

# Start database
echo "Starting PostgreSQL database..."
docker run -d --rm --name promat-service-database \
    -e "POSTGRES_DB=${USER}" \
    -e "POSTGRES_USER=${USER}" \
    -e "POSTGRES_PASSWORD=${USER}" \
    -e "LOG_FORMAT=${LOG_FORMAT}" \
    -p "${DB_PORT}:5432" \
    "${DB_IMAGE}" > /dev/null

# Wait for database to be ready
echo "Waiting for database to be ready..."
sleep 5

# Start application server
echo "Starting Payara application server..."
./scripts/start-server -d > /dev/null

# Wait until the app actually serves requests. /v1/api/subjects is unauthenticated and needs both
# a successful deployment and a migrated database (Flyway runs at startup, before the app serves).
echo "Waiting for application to start..."
APP_READY=false
for _ in $(seq 1 120); do
    if ! docker ps -q -f name=^promat-service-8080$ | grep -q .; then
        break
    fi
    if curl -sf -o /dev/null --max-time 5 "http://localhost:${PORT}/v1/api/subjects"; then
        APP_READY=true
        break
    fi
    sleep 2
done

if [ "$APP_READY" = "true" ] && [ "$DEV_SEED" = "true" ]; then
    # Runs inside the database container's network namespace, so "localhost" is always
    # that container - never a native Postgres that may also listen on the host's 5432.
    echo "Seeding sample data..."
    docker run --rm --network container:promat-service-database \
        -v "$(pwd)/scripts/feature-preview:/seed:ro" \
        -e PATH="/usr/lib/postgresql/13/bin:/usr/bin:/bin" \
        --entrypoint /seed/seed \
        "${DB_IMAGE}" \
        --host localhost --port 5432 \
        --dbname "${USER}" --dbuser "${USER}" --dbpassword "${USER}" > /dev/null \
        || echo "Seeding failed - continuing without sample data"
fi

if [ "$APP_READY" = "true" ]; then
    echo ""
    echo "Promat Service is running!"
    echo ""
    echo "API:        http://localhost:${PORT}/v1/api"
    echo "Swagger UI: http://localhost:${PORT}/v1/api/openapi-ui/"
    echo "Debug port: 9009"
    echo ""
    echo "Useful commands:"
    echo "   View logs:    docker logs -f promat-service-8080"
    echo "   Stop all:     ./scripts/stop"
    echo "   Rebuild:      ./scripts/dev-rebuild"
    echo ""
else
    echo ""
    echo "Application failed to start. Check logs:"
    echo "   docker logs promat-service-8080"
    echo ""
    exit 1
fi
