# Promat local development environment
#
# Copy this file to .env.local and replace values marked <required>.
# The startup scripts load .env.local automatically and fall back to
# defaults from scripts/common for values you leave unchanged here.

# -----------------------------------------------------------------------------
# Required: secrets / instance-specific values
# -----------------------------------------------------------------------------

PROMAT_DB_URL='<required: USER:PASSWORD@HOST:PORT/DBNAME>'
OAUTH2_CLIENT_ID='<required>'
OAUTH2_CLIENT_SECRET='<required>'
APP_NAME='<required: e.g. promat-service-dev>'

# -----------------------------------------------------------------------------
# Local safety defaults
# Keep these enabled unless you explicitly need production-like behavior.
# -----------------------------------------------------------------------------

PROMAT_SKIP_MIGRATIONS=true
PROMAT_DISABLE_SCHEDULED_JOBS=true
PROMAT_DISABLE_OUTBOUND_MAIL=true
PROMAT_CLUSTER_NAME=""

# -----------------------------------------------------------------------------
# Local runtime ports / tuning
# -----------------------------------------------------------------------------

PORT=8080
DB_PORT=5432
JAVA_MAX_HEAP_SIZE=2G
LOG_FORMAT=text

# -----------------------------------------------------------------------------
# External service defaults
# These match the current defaults in scripts/common and usually do not need
# local changes.
# -----------------------------------------------------------------------------

EMATERIAL_CONTENT_REPO="http://dmat.dbc.dk/eVALU/get.php?faust=%s"
CULR_SERVICE_URL="none"
CULR_SERVICE_USER_ID="none"
