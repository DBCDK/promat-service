OPENSEARCH_SERVICE_URL="http://opensearch-5-2-dbckat-service.cisterne.svc.cloud.dbc.dk/b3.5_5.2/"
RECORD_SERVICE="http://rawrepo-record-service.fbstest.svc.cloud.dbc.dk"
