FAUST_RESOLVER_URL="http://faust-resolver-service.fbstest.svc.cloud.dbc.dk"
OPENNUMBERROLL_SERVICE_URL="http://opennumberroll-service.metascrum-prod.svc.cloud.dbc.dk/1.1/"
